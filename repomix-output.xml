    borderRadius: 8,
    display: 'flex' as const,
    flexDirection: 'column' as const,
    fontFamily: 'var(--font-primary)',
    position: 'relative' as const,
  },
  headerWrapper: { position: 'relative' as const, flexShrink: 0 },
