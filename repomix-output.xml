interface NowPlayingPanelProps {
  onClose?: () => void;
  trackData: {
    title: string;
    artist: string;
    cover: string;
    type: 'song' | 'artist';
  } | null;
}

const queueData = [
  {
    id: 1,
    title: 'The Lie',
    artist: 'Long Afternoon',
    cover: 'https://via.placeholder.com/60/1a1a1a/ffffff?text=Lie',
  },
  {
