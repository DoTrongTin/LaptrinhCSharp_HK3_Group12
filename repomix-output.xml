  iconButton: { backgroundColor: 'transparent', border: 'none', cursor: 'pointer' as const, padding: 0, color: '#ffffff', display: 'flex' as const, alignItems: 'center' as const, justifyContent: 'center' as const, opacity: 0.8 },
