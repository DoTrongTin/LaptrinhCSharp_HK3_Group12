          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "AudioFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "ImageFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "Title": {
                    "type": "string"
                  },
                  "Artist": {
                    "type": "string"
